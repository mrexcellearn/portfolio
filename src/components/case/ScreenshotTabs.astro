---
// Tabbed real screenshots (dummy data painted over), each in a phone or laptop frame with its benefits beside it.
// Images live in public/. Laptop screens scroll when the screenshot is taller than the screen; tap a shot to open it full size.
import { url } from '../../lib/url';
export interface Benefit { title: string; note: string; }
export interface ShotTab { name: string; src: string; width: number; height: number; device: 'phone' | 'laptop'; alt?: string; benefits: Benefit[]; }
interface Props { tabs: ShotTab[]; title?: string; caption?: string; }
const { tabs, title = 'Screens', caption } = Astro.props;
const uid = `st${Math.random().toString(36).slice(2, 8)}`;
---
<figure class="shots" data-shots>
  <figcaption>
    <span class="t">{title}</span>
    {caption && <span class="small muted">{caption}</span>}
  </figcaption>
  <div class="tabs" role="tablist" aria-label={`${title}: screens`} hidden data-tabs>
    {tabs.map((s, i) => (
      <button type="button" role="tab" id={`${uid}-tab-${i}`} aria-controls={`${uid}-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="tn">{i + 1}</span>{s.name}
      </button>
    ))}
  </div>
  {tabs.map((s, i) => (
    <div class:list={['panel', `d-${s.device}`]} role="tabpanel" id={`${uid}-panel-${i}`} aria-labelledby={`${uid}-tab-${i}`} data-panel>
      <h4 class="panel-name small muted">Screen {i + 1}: {s.name}</h4>
      <div class="layout">
        <div class="device">
          {s.device === 'phone' ? (
            <a class="phone" href={url(s.src)} target="_blank" rel="noopener"><img src={url(s.src)} width={s.width} height={s.height} alt={s.alt ?? s.name} loading="lazy" decoding="async" /></a>
          ) : (
            <div class="laptop">
              <div class="lid"><div class="scr" tabindex="0" aria-label={`${s.name}, scrollable`}><a href={url(s.src)} target="_blank" rel="noopener"><img src={url(s.src)} width={s.width} height={s.height} alt={s.alt ?? s.name} loading="lazy" decoding="async" /></a></div></div>
              <div class="base" aria-hidden="true" />
            </div>
          )}
        </div>
        <ol class="notes" aria-label="What it solves">
          {s.benefits.map((b, n) => (
            <li>
              <span class="nn" aria-hidden="true">{n + 1}</span>
              <div><p class="nt">{b.title}</p><p class="nd small muted">{b.note}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  ))}
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-shots]').forEach((fig) => {
    const tablist = fig.querySelector<HTMLElement>('[data-tabs]');
    const tabs = [...fig.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...fig.querySelectorAll<HTMLElement>('[data-panel]')];
    if (!tablist || tabs.length < 2) return;
    tablist.hidden = false;
    fig.classList.add('tabbed');
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        panels[j].hidden = i !== j;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k === 'ArrowRight' || k === 'ArrowLeft' || k === 'Home' || k === 'End') {
          e.preventDefault();
          const n = k === 'Home' ? 0 : k === 'End' ? tabs.length - 1 : (i + (k === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
          select(n, true);
        }
      });
    });
    select(0);
  });
</script>
<style>
  .shots { margin: 32px 0; }
  figcaption { display: flex; flex-direction: column; gap: 2px; margin-bottom: 12px; }
  .t { font-weight: 500; }
  .tabs { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 20px; border-bottom: 1px solid var(--line); }
  .tabs button {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border: 0; background: none;
    font: inherit; font-size: var(--fs-small); color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px;
  }
  .tabs button[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--ink); }
  .tabs button:hover { color: var(--ink); }
  .tn { width: 20px; height: 20px; border-radius: 50%; border: 1px solid currentColor; display: grid; place-items: center; font-size: 0.6875rem; }
  .panel + .panel { margin-top: 40px; }
  .tabbed .panel + .panel { margin-top: 0; }
  .tabbed .panel-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .panel-name { margin: 0 0 12px; font-weight: 400; }
  .layout { display: grid; gap: 32px; align-items: start; }
  .d-phone .layout { grid-template-columns: minmax(0, 300px) minmax(0, 1fr); }
  .d-laptop .layout { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); }
  .device { min-width: 0; }
  .phone { display: block; background: #1d1d1d; border-radius: 34px; padding: 12px 10px; max-width: 300px; }
  .phone img { width: 100%; height: auto; border-radius: 22px; }
  .laptop { max-width: 640px; margin: 0 5%; }
  .lid { background: #1d1d1d; border-radius: 14px 14px 0 0; padding: 12px 12px 14px; }
  .scr { aspect-ratio: 16 / 10; overflow-y: auto; background: #fff; border-radius: 3px; scrollbar-width: thin; }
  .scr img { width: 100%; height: auto; }
  .phone, .scr a { cursor: zoom-in; }
  .base { height: 14px; margin: 0 -6%; background: linear-gradient(#cfd0cc, #b5b6b2); border-radius: 0 0 10px 10px; position: relative; }
  .base::before { content: ''; position: absolute; left: 50%; top: 0; width: 18%; height: 5px; transform: translateX(-50%); background: #a6a7a3; border-radius: 0 0 6px 6px; }
  .notes { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .notes li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; padding: 12px 0; border-top: 1px solid var(--line); }
  .notes li:first-child { border-top: 0; padding-top: 4px; }
  .nn { width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--line); color: var(--muted); font-size: 11px; font-weight: 600; display: grid; place-items: center; }
  .nt { margin: 0; font-weight: 500; font-size: 0.9375rem; }
  .nd { margin: 4px 0 0; }
  @media (max-width: 860px) {
    .d-phone .layout, .d-laptop .layout { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .phone { max-width: 240px; margin: 0 auto; }
    .laptop { margin: 0 6%; }
  }
</style>
