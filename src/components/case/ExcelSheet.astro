---
import type { Cell, Sheet } from './sheet-types';
import { idr } from '../../lib/format';

interface Props { sheets: Sheet[]; title?: string; caption?: string; }
const { sheets, title = 'Workbook', caption } = Astro.props;
const uid = `xl${Math.random().toString(36).slice(2, 8)}`;

const col = (i: number): string => (i < 26 ? String.fromCharCode(65 + i) : col(Math.floor(i / 26) - 1) + col(i % 26));
const parseRef = (ref: string) => {
  const m = ref.match(/^([A-Z]+)(\d+)$/)!;
  const c = [...m[1]].reduce((a, ch) => a * 26 + ch.charCodeAt(0) - 64, 0) - 1;
  return { c, r: Number(m[2]) - 1 };
};
const inRanges = (ranges: string[] | undefined, r: number, c: number) =>
  (ranges ?? []).some((rg) => {
    const [a, b = a] = rg.split(':');
    const p = parseRef(a), q = parseRef(b);
    return r >= Math.min(p.r, q.r) && r <= Math.max(p.r, q.r) && c >= Math.min(p.c, q.c) && c <= Math.max(p.c, q.c);
  });

const norm = (cell: Cell) => (cell !== null && typeof cell === 'object' ? cell : { v: cell });
const display = (cell: Cell): { text: string; num: boolean } => {
  const x = norm(cell);
  if (x.v === null || x.v === undefined || x.v === '') return { text: '', num: false };
  if (typeof x.v === 'number') {
    const fmt = 'fmt' in x ? x.fmt : undefined;
    if (fmt === 'pct') return { text: `${(x.v * 100).toFixed(0)}%`, num: true };
    if (fmt === 'num') return { text: Number.isInteger(x.v) ? String(x.v) : x.v.toFixed(1), num: true };
    return { text: idr(x.v), num: true };
  }
  return { text: String(x.v), num: false };
};
---
<figure class="xl" data-xl>
  <figcaption>
    <span class="t">{title}</span>
    {caption && <span class="small muted">{caption}</span>}
  </figcaption>
  <div class="book">
    <div class="fbar" aria-live="polite">
      <span class="ref" data-ref>A1</span>
      <span class="fx" aria-hidden="true">fx</span>
      <output class="formula" data-formula>Select a cell to see its formula</output>
    </div>
    {sheets.map((s, si) => {
      const ncols = Math.max(...s.rows.map((r) => r.length));
      const formulas = s.rows.flatMap((row, r) => row.map((cell, c) => ({ ref: `${col(c)}${r + 1}`, f: norm(cell) && 'f' in norm(cell) ? (norm(cell) as { f?: string }).f : undefined })).filter((x) => x.f));
      return (
        <div class="sheet" id={`${uid}-s${si}`} data-sheet role="tabpanel" aria-labelledby={`${uid}-t${si}`}>
          <p class="sheet-name small muted">Sheet: {s.name}</p>
          <div class="grid-wrap" tabindex="-1">
            <table class="grid" role="grid" aria-label={`${s.name} sheet`}>
              <colgroup>
                <col class="rh" />
                {Array.from({ length: ncols }, (_, c) => <col style={`width:${s.widths?.[c] ?? 96}px`} />)}
              </colgroup>
              <thead>
                <tr><th class="corner" aria-hidden="true"></th>{Array.from({ length: ncols }, (_, c) => <th scope="col" class="colh">{col(c)}</th>)}</tr>
              </thead>
              <tbody>
                {s.rows.map((row, r) => (
                  <tr class:list={{ header: r === 0 }}>
                    <th scope="row" class="rowh">{r + 1}</th>
                    {Array.from({ length: ncols }, (_, c) => {
                      const cell = row[c] ?? null;
                      const x = norm(cell) as { v: unknown; f?: string; bold?: boolean; note?: string };
                      const d = display(cell);
                      return (
                        <td
                          class:list={{ num: d.num, hl: inRanges(s.highlight, r, c), bold: x.bold || r === 0, hasf: !!x.f }}
                          data-ref={`${col(c)}${r + 1}`}
                          data-f={x.f ?? ''}
                          data-v={d.text}
                          title={x.f ? `=${x.f.replace(/^=/, '')}` : undefined}
                          tabindex={r === 0 && c === 0 ? 0 : -1}
                          aria-label={x.f ? `${col(c)}${r + 1}: ${d.text}, formula ${x.f}` : undefined}
                        >{d.text}</td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {s.caption && <p class="cap small muted">{s.caption}</p>}
          {formulas.length > 0 && (
            <details class="flist small">
              <summary>Formulas on this sheet ({formulas.length})</summary>
              <dl>{formulas.map((x) => <><dt>{x.ref}</dt><dd><code>{x.f!.startsWith('=') ? x.f : `=${x.f}`}</code></dd></>)}</dl>
            </details>
          )}
        </div>
      );
    })}
    <div class="sheettabs" role="tablist" aria-label="Sheets" hidden data-stabs>
      {sheets.map((s, si) => (
        <button type="button" role="tab" id={`${uid}-t${si}`} aria-controls={`${uid}-s${si}`} aria-selected={si === 0 ? 'true' : 'false'} tabindex={si === 0 ? 0 : -1}>{s.name}</button>
      ))}
    </div>
  </div>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-xl]').forEach((fig) => {
    const refEl = fig.querySelector<HTMLElement>('[data-ref]')!;
    const fEl = fig.querySelector<HTMLElement>('[data-formula]')!;
    const sheets = [...fig.querySelectorAll<HTMLElement>('[data-sheet]')];
    const tabs = [...fig.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const tablist = fig.querySelector<HTMLElement>('[data-stabs]')!;
    fig.classList.add('live');

    const select = (td: HTMLTableCellElement, focus = true) => {
      const table = td.closest('table')!;
      table.querySelectorAll('td.sel').forEach((x) => { x.classList.remove('sel'); (x as HTMLElement).tabIndex = -1; });
      td.classList.add('sel');
      td.tabIndex = 0;
      if (focus) td.focus();
      refEl.textContent = td.dataset.ref ?? '';
      const f = td.dataset.f;
      fEl.textContent = f ? (f.startsWith('=') ? f : `=${f}`) : td.dataset.v || '';
      fEl.classList.toggle('is-f', !!f);
    };

    sheets.forEach((sheet) => {
      const table = sheet.querySelector('table')!;
      table.addEventListener('click', (e) => {
        const td = (e.target as HTMLElement).closest('td');
        if (td) select(td as HTMLTableCellElement);
      });
      table.addEventListener('keydown', (e) => {
        const td = (e.target as HTMLElement).closest('td') as HTMLTableCellElement | null;
        if (!td) return;
        const tr = td.parentElement as HTMLTableRowElement;
        const rows = [...table.tBodies[0].rows];
        const r = rows.indexOf(tr);
        const c = td.cellIndex;
        const go = (nr: number, nc: number) => {
          const row = rows[Math.max(0, Math.min(rows.length - 1, nr))];
          const cell = row.cells[Math.max(1, Math.min(row.cells.length - 1, nc))];
          if (cell && cell.tagName === 'TD') { e.preventDefault(); select(cell as HTMLTableCellElement); }
        };
        if (e.key === 'ArrowDown') go(r + 1, c);
        else if (e.key === 'ArrowUp') go(r - 1, c);
        else if (e.key === 'ArrowRight') go(r, c + 1);
        else if (e.key === 'ArrowLeft') go(r, c - 1);
        else if (e.key === 'Home') go(r, 1);
        else if (e.key === 'End') go(r, tr.cells.length - 1);
      });
      table.addEventListener('focusin', (e) => {
        const td = (e.target as HTMLElement).closest('td');
        if (td && !td.classList.contains('sel')) select(td as HTMLTableCellElement, false);
      });
    });

    const show = (i: number, focus = false) => {
      sheets.forEach((s, j) => (s.hidden = i !== j));
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      if (focus) tabs[i].focus();
      const first = sheets[i].querySelector<HTMLTableCellElement>('td.hasf') ?? sheets[i].querySelector<HTMLTableCellElement>('td');
      if (first) select(first, false);
    };
    if (tabs.length) {
      tablist.hidden = false;
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => show(i));
        t.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            show((i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length, true);
          }
        });
      });
      show(0);
    }
  });
</script>
<style>
  .xl { margin: 32px 0; }
  figcaption { display: flex; flex-direction: column; gap: 2px; margin-bottom: 12px; }
  .t { font-weight: 500; }
  .book { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--bg); }
  .fbar { display: grid; grid-template-columns: 64px 28px 1fr; align-items: center; border-bottom: 1px solid var(--line); font-size: 0.8125rem; min-height: 36px; }
  .ref { padding: 0 10px; border-right: 1px solid var(--line); height: 100%; display: flex; align-items: center; font-family: var(--font-mono); font-size: 0.75rem; }
  .fx { color: var(--muted); font-style: italic; text-align: center; font-family: Georgia, serif; }
  .formula { padding: 6px 10px; font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); overflow-x: auto; white-space: nowrap; }
  .formula.is-f { color: var(--ink); }
  .xl:not(.live) .fbar { display: none; }
  .sheet-name { margin: 0; padding: 8px 12px; border-bottom: 1px solid var(--line); }
  .live .sheet-name { display: none; }
  .grid-wrap { overflow-x: auto; }
  .grid { border-collapse: collapse; table-layout: fixed; font-size: 0.8125rem; font-variant-numeric: tabular-nums; min-width: 100%; width: max-content; }
  .grid col.rh { width: 40px; }
  .grid th, .grid td { border: 1px solid var(--line); height: 28px; padding: 0 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .colh, .rowh, .corner { background: var(--band); color: var(--muted); font-weight: 400; font-size: 0.75rem; text-align: center; }
  .grid tr > :first-child { border-left: 0; }
  .grid thead th { border-top: 0; }
  .grid td { cursor: cell; text-align: left; }
  .grid td.num { text-align: right; }
  .grid tr.header td { background: color-mix(in srgb, var(--band) 60%, var(--bg)); font-weight: 500; }
  .grid td.bold { font-weight: 500; }
  .grid td.hl { background: color-mix(in srgb, var(--warn) 9%, transparent); }
  .grid td.hasf { position: relative; }
  .grid td.hasf::after { content: ''; position: absolute; top: 0; right: 0; border: 4px solid transparent; border-top-color: var(--ok-text); border-right-color: var(--ok-text); }
  .grid td.sel { outline: 2px solid var(--ink); outline-offset: -2px; }
  .grid td:focus-visible { outline: 2px solid var(--ink); outline-offset: -2px; border-radius: 0; }
  .cap { margin: 0; padding: 10px 12px; border-top: 1px solid var(--line); }
  .flist { padding: 8px 12px; border-top: 1px solid var(--line); }
  .flist summary { cursor: pointer; color: var(--muted); }
  .flist dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; margin: 8px 0 0; }
  .flist dt { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); }
  .flist dd { margin: 0; overflow-x: auto; }
  .flist code { font-size: 0.75rem; }
  .sheettabs { display: flex; gap: 0; border-top: 1px solid var(--line); background: var(--band); overflow-x: auto; }
  .sheettabs button {
    min-height: 40px; padding: 0 16px; border: 0; border-right: 1px solid var(--line); background: none;
    font: inherit; font-size: 0.8125rem; color: var(--muted); cursor: pointer; white-space: nowrap;
  }
  .sheettabs button[aria-selected='true'] { background: var(--bg); color: var(--ink); box-shadow: inset 0 2px 0 var(--ok); font-weight: 500; }
  .xl:not(.live) .sheet + .sheet { border-top: 1px solid var(--line); }
</style>
