---
// Recursive renderer for <PowerAutomateFlow>. Original styling; no vendor marks.
import type { Step } from './flow-types';

interface Props { steps: Step[]; depth?: number; }
const { steps, depth = 0 } = Astro.props;

const typeLabel = { trigger: 'Trigger', action: 'Action', condition: 'Condition', approval: 'Approval', loop: 'Apply to each' } as const;
const icons: Record<Step['type'], string> = {
  trigger: 'M13 2L4 14h7l-1 8 9-12h-7z',
  action: 'M4 12h16M14 6l6 6-6 6',
  condition: 'M12 3l9 9-9 9-9-9z',
  approval: 'M20 6L9 17l-5-5',
  loop: 'M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4M21 13v2a3 3 0 0 1-3 3H3',
};
---
<ol class:list={['steps', { nested: depth > 0 }]}>
  {steps.map((s) => (
    <li class:list={['step', `t-${s.type}`]}>
      <div class="card fx-step">
        <div class="top">
          <span class="ic" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={icons[s.type]} /></svg>
          </span>
          <div class="txt">
            <span class="kind">{typeLabel[s.type]}</span>
            <span class="title">{s.title}</span>
          </div>
        </div>
        {'detail' in s && s.detail && <p class="detail">{s.detail}</p>}
        {s.type === 'condition' && <code class="expr">{s.expression}</code>}
        {s.type === 'approval' && s.outcomes && (
          <p class="outcomes">{s.outcomes.map((o) => <span class="out">{o}</span>)}</p>
        )}
        {'config' in s && s.config && (
          <details class="config">
            <summary>Show configuration</summary>
            <dl>{Object.entries(s.config).map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
          </details>
        )}
      </div>
      {s.type === 'condition' && (
        <div class="branches">
          <div class="branch yes">
            <span class="blabel">If yes</span>
            {s.yes.length ? <Astro.self steps={s.yes} depth={depth + 1} /> : <p class="empty">No actions</p>}
          </div>
          <div class="branch no">
            <span class="blabel">If no</span>
            {s.no.length ? <Astro.self steps={s.no} depth={depth + 1} /> : <p class="empty">No actions</p>}
          </div>
        </div>
      )}
      {s.type === 'condition' && <span class="join" aria-hidden="true"></span>}
      {s.type === 'loop' && (
        <div class="loop-body"><Astro.self steps={s.body} depth={depth + 1} /></div>
      )}
    </li>
  ))}
</ol>
<style>
  .steps { width: 100%; min-width: 0; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: center; }
  .step { display: flex; flex-direction: column; align-items: center; width: 100%; min-width: 0; position: relative; }
  .step + .step { padding-top: 32px; }
  .step + .step::before { content: ''; position: absolute; top: 0; left: 50%; width: 1px; height: 32px; background: var(--ink); opacity: 0.4; }
  .step + .step::after { content: ''; position: absolute; top: 25px; left: calc(50% - 4px); border: 4px solid transparent; border-top-color: color-mix(in srgb, var(--ink) 40%, transparent); }
  .card { min-width: 0; width: 100%; max-width: 420px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; text-align: left; }
  .t-trigger > .card { border-top: 3px solid var(--ink); }
  .t-condition > .card { border-style: dashed; border-color: color-mix(in srgb, var(--ink) 35%, var(--line)); }
  .top { display: flex; gap: 12px; align-items: center; }
  .ic { width: 32px; height: 32px; flex: none; display: grid; place-items: center; border-radius: var(--radius-sm); background: var(--band); color: var(--ink); }
  .t-trigger .ic { background: var(--ink); color: #fff; }
  .txt { display: flex; flex-direction: column; min-width: 0; }
  .kind { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .title { font-weight: 500; font-size: 0.9375rem; line-height: 1.35; }
  .detail { margin: 8px 0 0; font-size: var(--fs-small); color: var(--muted); }
  .expr { display: block; margin-top: 10px; font-size: 0.75rem; background: var(--band); padding: 8px 10px; border-radius: 6px; overflow-x: auto; white-space: pre; }
  .outcomes { display: flex; gap: 6px; margin: 10px 0 0; flex-wrap: wrap; }
  .out { font-size: 0.75rem; border: 1px solid var(--line); border-radius: 999px; padding: 2px 8px; }
  .config { margin-top: 10px; border-top: 1px solid var(--line); padding-top: 8px; font-size: var(--fs-small); }
  .config summary { cursor: pointer; color: var(--muted); }
  .config summary:hover { color: var(--ink); }
  .config dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; margin: 8px 0 0; }
  .config dt { color: var(--muted); }
  .config dd { margin: 0; font-family: var(--font-mono); font-size: 0.75rem; word-break: break-word; }
  .branches { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; width: 100%; margin-top: 32px; position: relative; padding-top: 0; }
  .branches::before { content: ''; position: absolute; top: -32px; left: 50%; width: 1px; height: 16px; background: var(--ink); opacity: 0.4; }
  .branches::after { content: ''; position: absolute; top: -16px; left: 25%; right: 25%; height: 1px; background: var(--ink); opacity: 0.4; }
  .branch { min-width: 0; position: relative; display: flex; flex-direction: column; align-items: center; padding: 28px 12px 16px; border-radius: var(--radius); background: color-mix(in srgb, var(--band) 60%, transparent); }
  .branch::before { content: ''; position: absolute; top: -16px; left: 50%; width: 1px; height: 16px; background: var(--ink); opacity: 0.4; }
  .blabel { position: absolute; top: 6px; left: 12px; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 500; }
  .yes > .blabel { color: var(--ok); }
  .no > .blabel { color: var(--bad); }
  .join { width: 50%; height: 16px; border: 1px solid color-mix(in srgb, var(--ink) 40%, transparent); border-top: 0; border-radius: 0 0 8px 8px; }
  .empty { margin: 0; font-size: var(--fs-small); color: var(--muted); }
  .loop-body { width: 100%; margin-top: 16px; padding: 16px 12px; border: 1px dashed var(--line); border-radius: var(--radius); }
  .step { container-type: inline-size; }
  @container (max-width: 560px) {
    .branches { grid-template-columns: minmax(0, 1fr); }
    .join { width: 1px; border-width: 0 0 0 1px; border-radius: 0; }
    .branches::after { display: none; }
    .branch::before { display: none; }
    .branch + .branch { margin-top: 0; }
  }
</style>
