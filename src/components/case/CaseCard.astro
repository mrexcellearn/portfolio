---
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { url } from '../../lib/url';
import { caseSlug } from '../../lib/cases';
import { existsSync } from 'node:fs';

interface Props { entry: CollectionEntry<'caseStudies'>; headingLevel?: 'h2' | 'h3'; }
const { entry, headingLevel = 'h3' } = Astro.props;
const d = entry.data;
const H = headingLevel;
const top = d.metrics[0];
// Cover: the case's 16:9 thumbnail (a light .webp copy first, else the PNG).
const slug = caseSlug(entry);
const thumb = [`${slug}-card.webp`, `${slug}-16x9.png`]
  .map((f) => `/case-studies/${slug}/thumbnails/${f}`)
  .find((f) => existsSync(`public${f}`));
---
<Card href={url(`/case-studies/${slug}`)} class="case-card">
  <div class="media">
    {thumb ? <img src={url(thumb)} alt="" width="1280" height="720" loading="lazy" decoding="async" /> : (
      <div class="ph" aria-hidden="true">
        <span class="ph-eyebrow">Case study · {d.category}</span>
        <span class="ph-title">{d.title}</span>
        <span class="ph-stat"><b>{top.after}</b> {top.label.toLowerCase()}</span>
      </div>
    )}
  </div>
  <div class="body">
    <div class="head">
      <H class="title">{d.title}</H>
      <span class="go"><Icon name="arrow" size={18} /></span>
    </div>
    <p class="meta small muted"><span>{d.category}</span><span aria-hidden="true">·</span><span>{d.date}</span>{d.illustrative ? <Badge>Illustrative</Badge> : <Badge tone="ok">Real case</Badge>}</p>
    <p class="sum small muted">{d.summary}</p>
  </div>
</Card>
<style>
  /* "Selected works" style: the 16:9 thumbnail on top, compact text below. */
  :global(.card.case-card) { padding: 8px; gap: 0; }
  .media { aspect-ratio: 16 / 9; border-radius: var(--radius-sm); overflow: hidden; background: var(--band); }
  .media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 400ms ease; }
  :global(.case-card:hover) .media img { transform: scale(1.03); }
  .ph { height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 10px; padding: 8%; }
  .ph-eyebrow { font-size: var(--fs-small); color: var(--muted); }
  .ph-title { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: var(--fw-heading); letter-spacing: -0.03em; line-height: 1.05; max-width: 14ch; }
  .ph-stat { color: var(--muted); font-size: var(--fs-small); }
  .ph-stat b { color: var(--ok-text); font-size: 1.5rem; font-weight: var(--fw-heading); letter-spacing: -0.02em; margin-right: 4px; }
  .body { display: flex; flex-direction: column; gap: 6px; padding: 16px 12px 12px; }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .title { font-size: 1.125rem; font-weight: var(--fw-heading); margin: 0; }
  .go { display: grid; place-items: center; width: 32px; height: 32px; flex: none; border-radius: 50%; border: 1px solid var(--line); transition: background 150ms ease, color 150ms ease, border-color 150ms ease; }
  :global(.case-card:hover) .go { background: var(--ink); color: var(--card); border-color: var(--ink); }
  p { margin: 0; }
  .meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .sum { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
