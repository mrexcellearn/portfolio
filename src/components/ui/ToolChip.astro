---
// Tool pill with a small glyph tile in the tool's brand colour. Unknown tools fall back to a neutral pill.
import { toolStyle } from '../../lib/tools';
interface Props { name: string; }
const { name } = Astro.props;
const s = toolStyle(name);
---
<span class:list={['tool', { plain: !s }]} style={s ? `--c:${s.color}` : undefined}>
  {s ? (
    <span class="tile" aria-hidden="true">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d={s.glyph} /></svg>
    </span>
  ) : <span class="tile" aria-hidden="true" />}
  {name}
</span>
<style>
  .tool {
    --c: var(--muted);
    display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
    font-size: var(--fs-small); font-weight: 500; line-height: 1; padding: 4px 10px 4px 4px; border-radius: 999px;
    color: color-mix(in srgb, var(--c) 78%, #000);
    background: color-mix(in srgb, var(--c) 9%, #fff);
    border: 1px solid color-mix(in srgb, var(--c) 28%, #fff);
  }
  .tile { width: 20px; height: 20px; border-radius: 6px; background: var(--c); display: grid; place-items: center; flex: none; }
  .plain .tile { background: var(--line); }
</style>
