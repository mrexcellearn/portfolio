---
// "Illustrative example" badge and other small status labels.
interface Props { tone?: 'warn' | 'ok' | 'neutral'; }
const { tone = 'warn' } = Astro.props;
---
<span class:list={['badge', `badge-${tone}`]}><slot /></span>
<style>
  .badge {
    display: inline-flex; align-items: center; font-size: var(--fs-small); font-weight: 500;
    padding: 4px 8px; border-radius: 6px; line-height: 1.2;
  }
  .badge-warn { color: var(--warn-text); background: color-mix(in srgb, var(--warn) 10%, transparent); }
  .badge-ok { color: var(--ok-text); background: color-mix(in srgb, var(--ok) 10%, transparent); }
  .badge-neutral { color: var(--muted); background: var(--band); }
</style>
