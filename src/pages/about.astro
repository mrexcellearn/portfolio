---
import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import Chip from '../components/ui/Chip.astro';
import { site } from '../config/site.config';
import { skills, principles } from '../data/skills';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Finance Supervisor, AP & Treasury',
  address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
  email: site.email,
  knowsAbout: skills.flatMap((s) => s.items),
};
---
<Base title="About" description="Finance operations depth, builder skill and teaching: how Rey works and what he works with." jsonLd={jsonLd}>
  <section class="container intro">
    <h1>About</h1>
    <div class="story">
      {/* [PLACEHOLDER] Rey: replace with your own story, in your own words. */}
      <p class="lead">I run AP and Treasury in the mining and minerals industry in Indonesia. Most days that means payments, cash, and the controls around them.</p>
      <p>I started building tools because the work kept repeating. The same checks, the same copy and paste, the same emails asking where a request was. So I learned Power Apps, Power Automate, VBA and Apps Script, and started replacing the manual parts one process at a time.</p>
      <p>I care about two things at once: the finance being right, and the process being easy to follow. A good system does both. The control stays, and the friction goes.</p>
      <p>Outside work, I teach Excel and finance automation as Mr. Excellearn, because the shortcuts I learn the hard way are worth sharing.</p>
    </div>
  </section>

  <Section id="how" title="How I work" band>
    <ol class="principles">
      {principles.map((p, i) => (
        <li><span class="n small muted">0{i + 1}</span><div><h3>{p.title}</h3><p class="muted">{p.body}</p></div></li>
      ))}
    </ol>
  </Section>

  <Section id="skills" title="Skills">
    <div class="skills">
      {skills.map((g) => (
        <div>
          <h3>{g.group}</h3>
          <ul>{g.items.map((s) => <li>{s}</li>)}</ul>
        </div>
      ))}
    </div>
  </Section>

  <Section id="teaching" title="Mr. Excellearn" band>
    <div class="teach">
      <p>Short, practical Excel and finance-automation lessons on TikTok and LinkedIn. Formulas, shortcuts, and the small tools I build along the way.</p>
      <div class="chips"><Chip>Excel</Chip><Chip>Finance automation</Chip><Chip>Bahasa Indonesia</Chip></div>
      <div class="actions">
        <Button href={site.links.tiktok}>TikTok @ Mr. Excellearn</Button>
        <Button href={site.links.linkedin} variant="secondary">LinkedIn</Button>
      </div>
    </div>
  </Section>
</Base>
<style>
  .intro { padding-block: 64px 96px; display: grid; grid-template-columns: 1fr 1.6fr; gap: 48px; }
  .story { max-width: 62ch; }
  .lead { font-size: 1.375rem; font-weight: 300; line-height: 1.45; }
  .principles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 40px 64px; }
  .principles li { display: grid; grid-template-columns: 32px 1fr; gap: 12px; }
  .principles h3 { margin-bottom: 8px; }
  .principles p { margin: 0; }
  .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }
  .skills ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .skills li { padding: 10px 0; border-bottom: 1px solid var(--line); }
  .teach { max-width: 640px; }
  .teach p { font-size: 1.125rem; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 899px) {
    .intro, .principles, .skills { grid-template-columns: 1fr; }
    .intro { gap: 16px; }
  }
</style>
