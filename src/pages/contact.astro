---
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../config/site.config';

const subject = 'Free consultation request';
const key = site.contactForm.web3formsKey;
const topics = ['Process automation', 'Reporting or dashboards', 'Process documentation', 'Something else'];
---
<Base title="Contact" description="Book a free 30-minute call about a finance process you want to automate.">
  <section class="container page">
    <div class="head">
      <p class="eyebrow small muted">{site.consult.short}</p>
      <h1>Book a free <span class="nowrap">30-minute</span> call</h1>
      <p class="lead muted">Tell me about a process that still runs on email and spreadsheets. We map it together on a call and I tell you what I'd automate first. No cost, no obligation.</p>
    </div>

    <div class="grid">
      <form id="form" class="form" method="post" action={key ? 'https://api.web3forms.com/submit' : `mailto:${site.email}`} data-key={key} data-email={site.email} data-subject={subject}>
        {key && <input type="hidden" name="access_key" value={key} />}
        <input type="hidden" name="subject" value={subject} />
        <input type="hidden" name="from_name" value="Portfolio contact form" />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="row">
          <label>
            <span>Name</span>
            <input name="name" type="text" autocomplete="name" required />
          </label>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
        </div>
        <label>
          <span>Company or role <em class="muted">(optional)</em></span>
          <input name="company" type="text" autocomplete="organization" />
        </label>
        <label>
          <span>What do you need help with?</span>
          <select name="topic">
            {topics.map((t) => <option>{t}</option>)}
          </select>
        </label>
        <label>
          <span>Tell me about the process</span>
          <textarea name="message" rows="6" required placeholder="What happens today, the tools you use (Excel, SAP, SharePoint...), and where the time goes."></textarea>
        </label>

        <div class="send">
          <button type="submit" class="btn-submit">{site.consult.label} <Icon name="arrow" size={18} /></button>
          <p class="small muted">I reply within 2 working days with a few times for the call.</p>
        </div>
        <p class="status small" role="status" aria-live="polite" data-status></p>
      </form>

      <aside class="side">
        <h2>On the call</h2>
        <ol class="list">
          <li>You walk me through the process as it runs today.</li>
          <li>I point out where the time and errors come from.</li>
          <li>You leave with a first automation idea and the tools it needs.</li>
        </ol>

        <h2>Other ways to reach me</h2>
        <ul class="links">
          <li><a href={`mailto:${site.email}`}><span><Icon name="mail" size={18} /> {site.email}</span></a></li>
          <li><a href={site.links.linkedin}>LinkedIn <Icon name="arrow-up-right" size={16} /></a></li>
          <li><a href={site.links.tiktok}>TikTok {site.links.tiktokHandle} <Icon name="arrow-up-right" size={16} /></a></li>
        </ul>
        <p class="small muted">Based in {site.location}. Local time is shown in the top bar.</p>
      </aside>
    </div>
  </section>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('#form');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const say = (text: string, kind: 'ok' | 'bad' | '') => {
    if (!status) return;
    status.textContent = text;
    status.dataset.kind = kind;
  };
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (data.get('botcheck')) return;
    const { key, email, subject } = form.dataset;

    // No form key yet: open an email draft with the answers filled in.
    if (!key) {
      const body = ['name', 'email', 'company', 'topic', 'message']
        .map((f) => `${f[0].toUpperCase()}${f.slice(1)}: ${data.get(f) ?? ''}`)
        .join('\n');
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject ?? '')}&body=${encodeURIComponent(body)}`;
      return;
    }

    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    btn?.setAttribute('disabled', '');
    say('Sending...', '');
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(data)),
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      form.reset();
      say("Thanks, your request is in. I'll reply by email within 2 working days.", 'ok');
    } catch {
      say(`Something went wrong. Please email me at ${email} instead.`, 'bad');
    } finally {
      btn?.removeAttribute('disabled');
    }
  });
</script>
<style>
  .page { padding-block: 64px 96px; }
  .head { max-width: 720px; margin-bottom: 48px; }
  .nowrap { white-space: nowrap; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 12px; }
  .lead { font-size: 1.125rem; max-width: 56ch; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; border-top: 1px solid var(--line); padding-top: 48px; }

  .form { display: grid; gap: 20px; scroll-margin-top: 96px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  label { display: grid; gap: 6px; font-size: 0.9375rem; font-weight: 500; }
  label em { font-style: normal; font-weight: 400; }
  input, select, textarea {
    font: inherit; font-weight: 400; color: var(--ink); background: var(--bg);
    border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 11px 14px; min-height: 44px; width: 100%;
  }
  textarea { resize: vertical; min-height: 140px; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--ink); }
  .hp { position: absolute; left: -9999px; }
  .send { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 4px; }
  .send p { margin: 0; }
  .btn-submit {
    display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 22px; border: 0; cursor: pointer;
    border-radius: var(--radius-sm); background: var(--ink); color: #fff; font: inherit; font-weight: 500;
    transition: transform 150ms ease, background 150ms ease;
  }
  .btn-submit:hover { transform: translateY(-1px); background: #000; }
  .btn-submit[disabled] { opacity: 0.6; cursor: progress; }
  .status { margin: 0; min-height: 1.4em; }
  .status[data-kind='ok'] { color: var(--ok-text); }
  .status[data-kind='bad'] { color: var(--bad-text); }

  h2 { font-size: var(--fs-h3); font-weight: var(--fw-heading); margin: 0 0 12px; }
  .list { padding-left: 20px; margin: 0 0 40px; display: grid; gap: 10px; }
  .links { list-style: none; margin: 0 0 24px; padding: 0; border-top: 1px solid var(--line); }
  .links a { display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .links a span { display: inline-flex; align-items: center; gap: 10px; }
  .links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 899px) { .grid { grid-template-columns: 1fr; gap: 48px; } }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
</style>
