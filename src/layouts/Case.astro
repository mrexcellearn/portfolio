---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import ToolChip from '../components/ui/ToolChip.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../config/site.config';
import { url } from '../lib/url';
import { caseSlug } from '../lib/cases';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  headings: MarkdownHeading[];
  next?: CollectionEntry<'caseStudies'>;
}
const { entry, headings, next } = Astro.props;
const d = entry.data;
const toc = headings.filter((h) => h.depth === 2);
const month = (s: string) => {
  const [y, m] = s.split('-').map(Number);
  return m ? new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : s;
};
---
<Base title={d.title} description={d.summary}>
  <article class="case container">
    <header class="head reveal">
      <p class="crumb small"><a href={url('/case-studies')}>Case studies</a></p>
      <h1>{d.title}</h1>
      <p class="summary muted">{d.summary}</p>
      <dl class="facts small">
        <div><dt class="muted">Category</dt><dd>{d.category}</dd></div>
        <div><dt class="muted">Date</dt><dd>{month(d.date)}</dd></div>
        <div><dt class="muted">Role</dt><dd>{d.role}</dd></div>
        <div class="tools"><dt class="muted">Tools</dt><dd>{d.tools.map((t) => <ToolChip name={t} />)}</dd></div>
      </dl>
      <p>{d.illustrative ? <Badge>Illustrative example</Badge> : <Badge tone="ok">Real business case</Badge>}</p>
    </header>

    <div class="grid">
      {toc.length > 0 && (
        <nav class="toc small" aria-label="On this page">
          <p class="muted">On this page</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose">
        <slot />
        {d.illustrative ? (
          <p class="note small muted">
            Illustrative example. The company, vendors, people and amounts on this page are fictional, and the
            numbers show the shape of the result rather than measured data.
          </p>
        ) : (
          <p class="note small muted">
            Real business case. Names, amounts and screenshots are anonymized and use dummy data.
          </p>
        )}
      </div>
    </div>

    <footer class="next">
      {next && (
        <a class="next-link" href={url(`/case-studies/${caseSlug(next)}`)}>
          <span class="small muted">Next case</span>
          <span class="next-title">{next.data.title} <Icon name="arrow" /></span>
        </a>
      )}
      <div class="cta">
        <p>Running a process like this by hand? Book a free 30-minute call and we'll map it together.</p>
        <Button href={url('/contact#form')}>{site.consult.label}</Button>
      </div>
    </footer>
  </article>
</Base>
<style>
  .case { padding-block: 64px 96px; }
  .crumb a { color: var(--muted); text-underline-offset: 4px; }
  .head { max-width: 820px; margin-bottom: 64px; }
  .head h1 { font-size: clamp(2.25rem, 4vw + 1rem, 3.5rem); margin: 16px 0; }
  .summary { font-size: 1.125rem; max-width: 60ch; }
  .facts { display: flex; flex-wrap: wrap; gap: 16px 40px; margin: 32px 0 16px; padding-top: 24px; border-top: 1px solid var(--line); }
  .facts dt { margin-bottom: 4px; }
  .facts dd { margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 64px; }
  .toc { display: none; }
  @media (min-width: 1100px) {
    .grid { grid-template-columns: 200px minmax(0, 1fr); }
    .toc { display: block; position: sticky; top: 104px; align-self: start; }
    .toc ol { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 8px; border-left: 1px solid var(--line); }
    .toc a { display: block; padding-left: 16px; margin-left: -1px; border-left: 1px solid transparent; color: var(--muted); text-decoration: none; }
    .toc a:hover, .toc a.active { color: var(--ink); border-left-color: var(--ink); }
  }
  .prose { max-width: 820px; min-width: 0; }
  .prose :global(h2) { padding-top: 48px; margin-top: 16px; border-top: 1px solid var(--line); scroll-margin-top: 88px; }
  .prose :global(h2:first-child) { border-top: 0; padding-top: 0; margin-top: 0; }
  .prose :global(h3) { margin-top: 40px; }
  .prose :global(ul) { padding-left: 20px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose > :global(p), .prose > :global(ul) { max-width: 68ch; }
  .note { margin-top: 64px; padding-top: 16px; border-top: 1px solid var(--line); }
  .next { margin-top: 96px; display: grid; gap: 32px; }
  .next-link { display: flex; flex-direction: column; gap: 8px; padding: 32px 0; border-block: 1px solid var(--line); text-decoration: none; color: inherit; }
  .next-title { font-size: var(--fs-h2); font-weight: var(--fw-heading); display: inline-flex; align-items: center; gap: 12px; }
  .next-link:hover .next-title { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .cta { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cta p { margin: 0; font-size: 1.125rem; max-width: 44ch; }
</style>
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  if (links.length) {
    const map = new Map(links.map((a) => [a.hash.slice(1), a]));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          links.forEach((l) => l.classList.remove('active'));
          map.get(e.target.id)?.classList.add('active');
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    map.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
  }
</script>
